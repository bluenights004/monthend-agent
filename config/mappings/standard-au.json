{
  "description": "Standard AU management pack mapping. Each 'line' row maps Xero account codes to one pack line. 'ranges' are fallbacks: an account caught only by a range is flagged for confirmation. An account matched by nothing blocks the run.",
  "rows": [
    {"key": "pl.rev.contract",      "statement": "pl", "type": "line", "nature": "income",  "label": "Fitout contract revenue", "accounts": ["200"]},
    {"key": "pl.rev.products",      "statement": "pl", "type": "line", "nature": "income",  "label": "Joinery product sales",   "accounts": ["210"]},
    {"key": "pl.rev.total",         "statement": "pl", "type": "total", "nature": "income", "label": "Total revenue", "sum": ["pl.rev.contract", "pl.rev.products"]},
    {"key": "pl.cos.materials",     "statement": "pl", "type": "line", "nature": "expense", "label": "Materials",       "accounts": ["310"]},
    {"key": "pl.cos.subcontractors","statement": "pl", "type": "line", "nature": "expense", "label": "Subcontractors",  "accounts": ["320"]},
    {"key": "pl.cos.labour",        "statement": "pl", "type": "line", "nature": "expense", "label": "Direct labour",   "accounts": ["330"], "ranges": [["300", "399"]]},
    {"key": "pl.cos.total",         "statement": "pl", "type": "total", "nature": "expense", "label": "Total cost of sales", "sum": ["pl.cos.materials", "pl.cos.subcontractors", "pl.cos.labour"]},
    {"key": "pl.gross_profit",      "statement": "pl", "type": "total", "nature": "income", "label": "Gross profit", "sum": ["pl.rev.total", "-pl.cos.total"]},
    {"key": "pl.other_income",      "statement": "pl", "type": "line", "nature": "income",  "label": "Other income", "accounts": ["260"], "ranges": [["250", "299"]]},
    {"key": "pl.opex.salaries",     "statement": "pl", "type": "line", "nature": "expense", "label": "Administration salaries and on-costs", "accounts": ["477", "478"]},
    {"key": "pl.opex.occupancy",    "statement": "pl", "type": "line", "nature": "expense", "label": "Occupancy",          "accounts": ["420", "445"]},
    {"key": "pl.opex.marketing",    "statement": "pl", "type": "line", "nature": "expense", "label": "Marketing",          "accounts": ["400"]},
    {"key": "pl.opex.motor",        "statement": "pl", "type": "line", "nature": "expense", "label": "Motor vehicles",     "accounts": ["489"]},
    {"key": "pl.opex.insurance",    "statement": "pl", "type": "line", "nature": "expense", "label": "Insurance",          "accounts": ["493"]},
    {"key": "pl.opex.admin",        "statement": "pl", "type": "line", "nature": "expense", "label": "Administration and professional fees", "accounts": ["404", "412", "461"]},
    {"key": "pl.opex.depreciation", "statement": "pl", "type": "line", "nature": "expense", "label": "Depreciation",       "accounts": ["416"]},
    {"key": "pl.opex.other",        "statement": "pl", "type": "line", "nature": "expense", "label": "Other operating expenses", "accounts": [], "ranges": [["400", "499"]]},
    {"key": "pl.opex.total",        "statement": "pl", "type": "total", "nature": "expense", "label": "Total operating expenses", "sum": ["pl.opex.salaries", "pl.opex.occupancy", "pl.opex.marketing", "pl.opex.motor", "pl.opex.insurance", "pl.opex.admin", "pl.opex.depreciation", "pl.opex.other"]},
    {"key": "pl.ebit",              "statement": "pl", "type": "total", "nature": "income", "label": "Operating profit (EBIT)", "sum": ["pl.gross_profit", "pl.other_income", "-pl.opex.total"]},
    {"key": "pl.finance_costs",     "statement": "pl", "type": "line", "nature": "expense", "label": "Finance costs", "accounts": ["437"]},
    {"key": "pl.net_profit",        "statement": "pl", "type": "total", "nature": "income", "label": "Net profit before tax", "sum": ["pl.ebit", "-pl.finance_costs"]},

    {"key": "bs.cash",              "statement": "bs", "type": "line", "nature": "asset", "label": "Cash at bank", "accounts": ["090", "091"]},
    {"key": "bs.receivables",       "statement": "bs", "type": "line", "nature": "asset", "label": "Trade receivables", "accounts": ["610"]},
    {"key": "bs.inventory",         "statement": "bs", "type": "line", "nature": "asset", "label": "Inventory", "accounts": ["630"]},
    {"key": "bs.other_current",     "statement": "bs", "type": "line", "nature": "asset", "label": "Prepayments and other current assets", "accounts": ["620"], "ranges": [["600", "699"]]},
    {"key": "bs.ppe",               "statement": "bs", "type": "line", "nature": "asset", "label": "Plant and equipment (net)", "accounts": ["710", "711"], "ranges": [["700", "799"]]},
    {"key": "bs.total_assets",      "statement": "bs", "type": "total", "nature": "asset", "label": "Total assets", "sum": ["bs.cash", "bs.receivables", "bs.inventory", "bs.other_current", "bs.ppe"]},
    {"key": "bs.payables",          "statement": "bs", "type": "line", "nature": "liability", "label": "Trade payables", "accounts": ["800"]},
    {"key": "bs.tax",               "statement": "bs", "type": "line", "nature": "liability", "label": "GST and PAYG payable", "accounts": ["820", "825"]},
    {"key": "bs.accruals",          "statement": "bs", "type": "line", "nature": "liability", "label": "Accrued expenses", "accounts": ["830"]},
    {"key": "bs.employee",          "statement": "bs", "type": "line", "nature": "liability", "label": "Employee entitlements", "accounts": ["826", "840"], "ranges": [["800", "899"]]},
    {"key": "bs.borrowings",        "statement": "bs", "type": "line", "nature": "liability", "label": "Borrowings", "accounts": ["900"], "ranges": [["900", "949"]]},
    {"key": "bs.total_liabilities", "statement": "bs", "type": "total", "nature": "liability", "label": "Total liabilities", "sum": ["bs.payables", "bs.tax", "bs.accruals", "bs.employee", "bs.borrowings"]},
    {"key": "bs.net_assets",        "statement": "bs", "type": "total", "nature": "asset", "label": "Net assets", "sum": ["bs.total_assets", "-bs.total_liabilities"]},
    {"key": "bs.share_capital",     "statement": "bs", "type": "line", "nature": "equity", "label": "Share capital", "accounts": ["970"]},
    {"key": "bs.retained_earnings", "statement": "bs", "type": "line", "nature": "equity", "label": "Retained earnings (opening)", "accounts": ["960"], "ranges": [["950", "999"]]},
    {"key": "bs.current_earnings",  "statement": "bs", "type": "earnings", "nature": "equity", "label": "Current year earnings"},
    {"key": "bs.total_equity",      "statement": "bs", "type": "total", "nature": "equity", "label": "Total equity", "sum": ["bs.share_capital", "bs.retained_earnings", "bs.current_earnings"]}
  ]
}
