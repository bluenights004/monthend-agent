# Copy to your secret manager or a launchd/systemd EnvironmentFile. Never commit real values.
# This application does not read .env files itself.

# Claude (direct API path: `monthend commentary draft --engine claude`, `monthend eval --engine claude`)
ANTHROPIC_API_KEY=
# MONTHEND_MODEL=claude-opus-5-5

# Xero app (developer.xero.com). XERO_AUTH_MODE=client_credentials for a custom connection.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_AUTH_MODE=authorization_code
XERO_TENANT_ID=
XERO_WEBHOOK_KEY=

# Microsoft Entra app registration (app-only Graph access)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SHAREPOINT_HOST=yourfirm.sharepoint.com
M365_SHAREPOINT_SITE=sites/Clients

# Runtime
# MONTHEND_BACKEND=live            # overrides each client's source.backend
# MONTHEND_VAR_DIR=/srv/monthend/var
# MONTHEND_NOTIFY_WEBHOOK=         # internal Teams/Slack incoming webhook for the morning summary
